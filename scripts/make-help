#!/usr/bin/env python3
"""Display documented Makefile targets grouped by section."""

# Upstream: https://github.com/gi8lino/dev-tools
# Version: 0.3.0

import argparse
from pathlib import Path
import re


CYAN = "\033[36m"
BOLD = "\033[1m"
RESET = "\033[0m"

SECTION_PREFIX = "##@"

TARGET_PATTERN = re.compile(
    r"^([a-zA-Z_0-9-]+):.*?##\s*(.+?)\s*$",
)


def print_usage():
    print()
    print("Usage:")
    print(f"  make {CYAN}<target>{RESET}")


def print_section(line):
    section = line[len(SECTION_PREFIX):].strip()
    print()
    print(f"{BOLD}{section}{RESET}")


def print_target(match):
    target = match.group(1)
    description = match.group(2)
    print(f"  {CYAN}{target:<20}{RESET} {description}")


def process(path):
    try:
        lines = path.read_text().splitlines()
    except OSError as error:
        raise RuntimeError(f"{path}: {error}") from error

    for line in lines:
        if line.startswith(SECTION_PREFIX):
            print_section(line)
            continue

        match = TARGET_PATTERN.match(line)
        if match:
            print_target(match)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--version",
        action="version",
        version="make-help 0.3.0",
    )
    parser.add_argument(
        "makefiles",
        nargs="*",
        type=Path,
        default=[Path("Makefile")],
        help="Makefiles to inspect, default: Makefile",
    )
    args = parser.parse_args()

    print_usage()

    try:
        for path in args.makefiles:
            process(path)
    except RuntimeError as error:
        parser.exit(1, f"make-help: {error}\n")


if __name__ == "__main__":
    main()
