#!/usr/bin/env python3
"""Wait for a local HTTP endpoint and open it in the default browser."""

# Upstream: https://github.com/gi8lino/dev-tools
# Version: 0.2.0

import argparse
import time
import urllib.error
import urllib.request
from urllib.parse import urlparse
import webbrowser


def reachable(url, timeout):
    request = urllib.request.Request(url, method="HEAD")
    try:
        with urllib.request.urlopen(request, timeout=timeout):
            return True
    except urllib.error.HTTPError:
        # Any HTTP response proves that the server is reachable.
        return True
    except (OSError, urllib.error.URLError):
        return False


def wait_for_url(url, timeout, interval):
    deadline = time.monotonic() + timeout
    while True:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            return False
        if reachable(url, min(1.0, remaining)):
            return True
        time.sleep(min(interval, max(0.0, deadline - time.monotonic())))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--version", action="version", version="open-browser 0.2.0")
    parser.add_argument("--timeout", type=float, default=60.0, help="seconds to wait for the endpoint")
    parser.add_argument("--interval", type=float, default=0.25, help="seconds between connection attempts")
    parser.add_argument("url", help="HTTP or HTTPS URL to open")
    args = parser.parse_args()

    parsed = urlparse(args.url)
    if parsed.scheme not in {"http", "https"} or not parsed.netloc:
        parser.error("URL must use http or https and include a host")
    if args.timeout <= 0:
        parser.error("--timeout must be greater than zero")
    if args.interval <= 0:
        parser.error("--interval must be greater than zero")

    if not wait_for_url(args.url, args.timeout, args.interval):
        parser.exit(1, f"open-browser: timed out waiting for {args.url}\n")
    if not webbrowser.open(args.url):
        parser.exit(1, f"open-browser: could not open browser for {args.url}\n")


if __name__ == "__main__":
    main()
